# Microsoft Entra app registration (public client; no client secret)
CLIENT_ID=6579b82a-843b-4461-9016-abd09e928a65
TENANT_ID=consumers
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── ML / Treinamento ─────────────────────────────────────────
# Opcional: treinar ao iniciar o backend
TRAIN_ON_START=false
# Padrão: 24 horas (ms). Use valor menor para testes locais.
DAILY_TRAIN_INTERVAL_MS=86400000
# Debounce entre feedbacks e próximo retreinamento (padrão: 15s)
TRAINING_DEBOUNCE_MS=15000

# ── Auto-Clean ───────────────────────────────────────────────
# Intervalo do job automático de limpeza (padrão: 12 horas em ms)
AUTO_CLEAN_INTERVAL_MS=43200000
# Ação padrão: 'move' (arquiva) ou 'delete'
AUTO_CLEAN_ACTION=move
# Período de carência mínimo em dias para limpar
AUTO_CLEAN_DAYS=7
# Definir como 'true' para rodar sem efetuar ações (simulação)
AUTO_CLEAN_DRY_RUN=false
